# --- MongoDB (usuarios, progreso y datos para mejorar la IA) ---
# Con MongoDB Atlas: Database Access > crea un usuario con permiso readWrite,
# Network Access > permite tu IP, y copia el host de Connect > Drivers.
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_HOST=cluster0.xxxxx.mongodb.net
MONGODB_DB=lingua-tutor
# Alternativa: una URI completa (tiene prioridad sobre las variables de arriba).
# MONGODB_URI=mongodb://127.0.0.1:27017/lingua-tutor
# Tras configurarlo, crea las colecciones e índices con:  npm run db:init

# --- Login con Google (Auth.js) ---
# Si falta alguna de las tres, el login se desactiva y la app funciona en modo anónimo.
# 1. Entra a https://console.cloud.google.com/apis/credentials y crea un proyecto.
# 2. Configura la "Pantalla de consentimiento de OAuth" (tipo Externo; añade tu correo como usuario de prueba).
# 3. Crear credenciales > ID de cliente de OAuth > Aplicación web.
# 4. URI de redireccionamiento autorizado (exactamente):
#      http://localhost:3001/api/auth/callback/google
#    (si usas otro puerto o dominio, cambia esa URL; en producción añade la de tu dominio)
# 5. Copia el ID y el secreto aquí. AUTH_SECRET se genera con: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Proveedor preferido: google | groq | openrouter | openai.
# En la app puedes elegir "Automática": usa este primero y, si falla, los demás con clave.
AI_PROVIDER=google

# Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
# Uno o varios modelos separados por comas: si uno falla (saturado, retirado) se prueba el siguiente.
GOOGLE_MODEL=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-flash-latest

# Búsqueda web de Gemini en el chat. En el nivel gratuito su cuota puede ser 0;
# la app la desactiva sola 15 min tras un 429. Pon "off" para no intentarla nunca.
GOOGLE_SEARCH=on

# Crear imágenes en el chat. Gemini no tiene cuota gratuita para imágenes: tras un 429
# la app usa Pollinations (gratis, sin clave). Pon "off" para ir directo a Pollinations.
GOOGLE_IMAGE=on
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image,gemini-2.5-flash-image

# Crear audio (texto a voz) en el chat. Incluido en el nivel gratuito de Gemini.
GOOGLE_TTS_MODEL=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-2.5-flash-preview-tts

# Groq (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (https://openrouter.ai) - usa modelos con sufijo :free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Opcional, de pago
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Opcional: API oficial de YouTube para buscar videos (sin ella se lee la página pública)
YOUTUBE_API_KEY=
